# Copy to `.env` or `.env.local` for local development.
# Only variables prefixed with VITE_ are exposed to the client bundle.
#
# Microsoft Clarity project ID (optional).
# Used in production builds to enable session analytics; leave blank to disable.
VITE_CLARITY_PROJECT_ID=

# Google Web Fonts API key (server-side only, used by /api/fonts proxy).
# Obtain from https://developers.google.com/fonts/docs/developer_api and set it as a secret on Vercel.
GOOGLE_FONT_KEY=
